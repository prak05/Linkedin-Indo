terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.7"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Region comes from the AWS_REGION environment variable; never set it here.
provider "aws" {
  default_tags {
    tags = {
      Environment = "Workshop"
      Project     = "Serverless with AI"
    }
  }
}
